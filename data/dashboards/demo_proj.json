{
  "version": "1.0.0",
  "project_id": "demo_proj",
  "title": "Smart Traffic Flow & Highway Telemetry Center",
  "theme": "dark",
  "canvas": {
    "width": 1440,
    "height": 960,
    "background": "#0B0F19"
  },
  "widgets": [
    {
      "id": "w_head",
      "type": "custom_text",
      "x": 30,
      "y": 24,
      "w": 700,
      "h": 60,
      "z": 1,
      "config": {
        "text": "Traffic Control & Highway Telemetry Center",
        "tag": "h1",
        "fontSize": 24,
        "color": "#38BDF8",
        "subtitle": "Klasifikasi Kendaraan Real-time, Gerbang Tol ANPR, dan Analitik Laju Aliran"
      }
    },
    {
      "id": "w_badge",
      "type": "status_badge",
      "x": 1200,
      "y": 30,
      "w": 210,
      "h": 48,
      "z": 1,
      "config": {
        "label": "Gerbang Tol Cikampek (Live)",
        "status": "online",
        "shift": "Operasional 24 Jam"
      }
    },
    {
      "id": "w_sc1",
      "type": "scorecard",
      "x": 30,
      "y": 95,
      "w": 260,
      "h": 120,
      "z": 2,
      "config": {
        "metricKey": "vehicle_count",
        "title": "Total Kendaraan Hari Ini",
        "unit": "Unit",
        "warningThreshold": 1500,
        "dangerThreshold": 2500,
        "defaultValue": 1248
      }
    },
    {
      "id": "w_sc2",
      "type": "scorecard",
      "x": 310,
      "y": 95,
      "w": 260,
      "h": 120,
      "z": 2,
      "config": {
        "metricKey": "avg_speed",
        "title": "Kecepatan Rata-rata",
        "unit": "km/h",
        "warningThreshold": 45,
        "dangerThreshold": 30,
        "defaultValue": 68.4
      }
    },
    {
      "id": "w_sc3",
      "type": "scorecard",
      "x": 590,
      "y": 95,
      "w": 260,
      "h": 120,
      "z": 2,
      "config": {
        "metricKey": "violation_shoulder",
        "title": "Pelanggaran Bahu Jalan",
        "unit": "Kasus",
        "warningThreshold": 5,
        "dangerThreshold": 10,
        "defaultValue": 3
      }
    },
    {
      "id": "w_sc4",
      "type": "scorecard",
      "x": 870,
      "y": 95,
      "w": 260,
      "h": 120,
      "z": 2,
      "config": {
        "metricKey": "flow_rate",
        "title": "Laju Aliran Trafik",
        "unit": "Mobil/m",
        "warningThreshold": 25,
        "dangerThreshold": 40,
        "defaultValue": 18.2
      }
    },
    {
      "id": "w_excel",
      "type": "excel_export_btn",
      "x": 1150,
      "y": 95,
      "w": 260,
      "h": 50,
      "z": 2,
      "config": {
        "label": "Unduh Rekap Lalu Lintas (.xlsx)",
        "includeEvents": true,
        "includeMetrics": true
      }
    },
    {
      "id": "w_cctv1",
      "type": "cctv_player",
      "x": 30,
      "y": 235,
      "w": 660,
      "h": 400,
      "z": 3,
      "config": {
        "cameraLabel": "Kamera Gerbang Masuk Tol (ANPR)",
        "streamId": "cam_toll_in",
        "nodeId": "preview",
        "showAnnotatedToggle": true,
        "showSnapshotBtn": true,
        "showFullscreenBtn": true
      }
    },
    {
      "id": "w_cctv2",
      "type": "cctv_player",
      "x": 710,
      "y": 235,
      "w": 700,
      "h": 400,
      "z": 3,
      "config": {
        "cameraLabel": "Kamera Jalur Cepat & Bahu Jalan",
        "streamId": "cam_highway_flow",
        "nodeId": "detector",
        "showAnnotatedToggle": true,
        "showSnapshotBtn": true,
        "showFullscreenBtn": true
      }
    },
    {
      "id": "w_chart",
      "type": "trend_chart",
      "x": 30,
      "y": 655,
      "w": 660,
      "h": 280,
      "z": 4,
      "config": {
        "title": "Grafik Fluktuasi Volume Kendaraan (24 Jam)",
        "metricKey": "vehicle_count",
        "chartType": "line",
        "rangeHours": 24
      }
    },
    {
      "id": "w_table",
      "type": "event_table",
      "x": 710,
      "y": 655,
      "w": 700,
      "h": 280,
      "z": 4,
      "config": {
        "title": "Tabel Deteksi Plat Nomor & Klasifikasi",
        "maxRows": 30,
        "autoScroll": true,
        "showFilter": true
      }
    }
  ]
}