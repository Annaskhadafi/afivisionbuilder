{
  "version": "1.0.0",
  "project_id": "default",
  "title": "Interactive Web Computer Vision Studio",
  "theme": "light",
  "canvas": {
    "width": 1440,
    "height": 980,
    "background": "#080D19"
  },
  "widgets": [
    {
      "id": "w_cv_navbar",
      "type": "dashboard_navbar",
      "x": 0,
      "y": 0,
      "w": 1440,
      "h": 56,
      "z": 1,
      "config": {
        "title": "WEB COMPUTER VISION STUDIO",
        "subtitle": "Interactive Inference & Analytics Platform",
        "showClock": true,
        "showShift": true
      }
    },
    {
      "id": "w_cv_input",
      "type": "media_input_controller",
      "x": 20,
      "y": 70,
      "w": 440,
      "h": 460,
      "z": 2,
      "config": {
        "title": "Media Input & Inference Controller",
        "defaultMode": "single_analysis",
        "confidence": 0.25,
        "iouThreshold": 0.45,
        "autoRunOnDrop": true
      }
    },
    {
      "id": "w_cv_kpi",
      "type": "stat_kpi_card",
      "x": 20,
      "y": 545,
      "w": 440,
      "h": 105,
      "z": 2,
      "config": {
        "title": "Total Objek Terdeteksi",
        "metricKey": "total_detected",
        "accentColor": "#0284c7",
        "icon": "users"
      }
    },
    {
      "id": "w_cv_viewer",
      "type": "vision_result_viewer",
      "x": 480,
      "y": 70,
      "w": 940,
      "h": 580,
      "z": 2,
      "config": {
        "title": "Hasil Visual Analisis AI (Annotated Result)",
        "showBeforeAfterSlider": true,
        "showZoomControls": true,
        "showDownloadBtn": true
      }
    },
    {
      "id": "w_cv_table_conf",
      "type": "confidence_table",
      "x": 20,
      "y": 665,
      "w": 720,
      "h": 295,
      "z": 2,
      "config": {
        "title": "Tabel Hasil Konfiden Deteksi (Detections)",
        "showCrops": true,
        "showScoreBar": true,
        "showBboxCoords": true,
        "showExportBtn": true
      }
    },
    {
      "id": "w_cv_table_analytics",
      "type": "custom_analytics_table",
      "x": 760,
      "y": 665,
      "w": 660,
      "h": 295,
      "z": 2,
      "config": {
        "title": "Tabel Kustom Analitik Alur Kerja",
        "showZoneSummary": true,
        "showClassCounter": true,
        "showExportBtn": true
      }
    }
  ],
  "id": "default"
}