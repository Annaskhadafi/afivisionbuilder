# ==========================================================
# AFI Vision Builder - Environment Configuration for Dokploy
# ==========================================================

# Port Aplikasi Web
PORT=8765

# Host Binding & Allowed Hosts
VISONODE_WEB_HOST=0.0.0.0
VISONODE_WEB_PORT=8765
ALLOWED_HOSTS=*

# ==========================================================
# Dokploy Persistent Mount Options
# ==========================================================
# OPSI A (Rekomendasi Default Dokploy):
# Kosongkan DATA_PATH dan WEIGHTS_PATH agar menggunakan Docker Named Volume
# (afi_vision_data & afi_vision_weights) yang otomatis persisten di Dokploy.
# DATA_PATH=afi_vision_data
# WEIGHTS_PATH=afi_vision_weights

# OPSI B (Persistent Bind Mount Host Disk - One Chitra Standard):
# Jika ingin memetakan langsung ke folder host VPS Dokploy:
# DATA_PATH=/mnt/data/visonode/data
# WEIGHTS_PATH=/mnt/data/visonode/weights
